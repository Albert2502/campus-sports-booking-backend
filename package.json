{
  "name": "campus-sports-booking-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for Campus Sports Booking",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:dev-passwords": "node db/dev-passwords.js",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all && node db/dev-passwords.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/test-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
