# Copy to .env and fill in the values. Never commit .env.
PORT=3000
# Origin of the Vite dev server allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Local PostgreSQL (16 or newer).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_sports_dev
DB_USER=postgres
DB_PASSWORD=change_me
# Database used by npm test; it is wiped on every run.
DB_NAME_TEST=campus_sports_test

# Long random string that signs the login tokens.
JWT_SECRET=change_me_to_a_long_random_string
# Only emails from this domain can sign in (the seed accounts use campus.test).
ALLOWED_EMAIL_DOMAIN=campus.test
